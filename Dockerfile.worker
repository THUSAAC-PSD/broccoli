# syntax=docker/dockerfile:1.7
# hadolint global ignore=DL3002

ARG RUST_IMAGE=rust:bookworm@sha256:adab7941580c74513aa3347f2d2a1f975498280743d29ec62978ba12e3540d3a
ARG RUNTIME_IMAGE=ubuntu:20.04@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214

FROM ${RUST_IMAGE} AS chef

ARG USE_CN_MIRRORS=false
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
WORKDIR /app

RUN if [ "$USE_CN_MIRRORS" = "true" ]; then \
      mkdir -p /usr/local/cargo && \
      printf '[source.crates-io]\nreplace-with = "rsproxy-sparse"\n\n[source.rsproxy-sparse]\nregistry = "sparse+https://rsproxy.cn/index/"\n' \
        > /usr/local/cargo/config.toml; \
    fi

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    if [ "$USE_CN_MIRRORS" = "true" ]; then \
      export RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup \
        RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup; \
    fi && \
    cargo install cargo-chef --version 0.1.73 --locked

COPY . .
RUN if [ "$USE_CN_MIRRORS" = "true" ]; then \
      export RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup \
        RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup; \
    fi && \
    cargo chef prepare --recipe-path recipe.json

FROM ${RUST_IMAGE} AS rust-builder

ARG USE_CN_MIRRORS=false
ARG CARGO_BUILD_PROFILE=release
ARG CARGO_BUILD_RUSTFLAGS=
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
WORKDIR /app

ARG MUSL_TARGET=x86_64-unknown-linux-musl

# musl-static worker + broccoli-compare: built on glibc 2.36 they fail on the
# focal (glibc 2.31) runtime base, and broccoli-compare runs INSIDE the isolate
# sandbox on the judged userland. Static musl makes both glibc-independent.
# (bookworm base here uses deb822 sources; runtime stages below are focal.)
# cmake + clang/libclang are for aws-lc-sys (worker's rustls/aws-lc-rs TLS
# provider) which compiles C/asm crypto under the musl target.
# hadolint ignore=DL3008
RUN if [ "$USE_CN_MIRRORS" = "true" ]; then \
      sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends musl-tools cmake clang libclang-dev && \
    rm -rf /var/lib/apt/lists/*

RUN if [ "$USE_CN_MIRRORS" = "true" ]; then \
      mkdir -p /usr/local/cargo && \
      printf '[source.crates-io]\nreplace-with = "rsproxy-sparse"\n\n[source.rsproxy-sparse]\nregistry = "sparse+https://rsproxy.cn/index/"\n' \
        > /usr/local/cargo/config.toml; \
    fi

COPY --from=chef /usr/local/cargo/bin/cargo-chef /usr/local/cargo/bin/cargo-chef
COPY --from=chef /app/recipe.json recipe.json
COPY rust-toolchain.toml rust-toolchain.toml
# The root [patch.crates-io] repoints broccoli_queue at the vendored crate under
# third_party/. `cargo chef cook` resolves that patch before `COPY . .`, so the
# vendored source must be present now or cook panics ("patch location ... does
# not contain packages matching broccoli_queue").
COPY third_party third_party

# rust-toolchain.toml pins the active toolchain (nightly) from this point on,
# so the musl target must be added HERE (not earlier, before the pin is in
# place) or it lands on the base image's default toolchain instead of the
# pinned one, and every later --target build fails with a missing target.
RUN if [ "$USE_CN_MIRRORS" = "true" ]; then \
      export RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup \
        RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup; \
    fi && \
    rustup target add "$MUSL_TARGET"

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    if [ "$USE_CN_MIRRORS" = "true" ]; then \
      export RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup \
        RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup; \
    fi && \
    cargo chef cook --release --locked --recipe-path recipe.json --target "$MUSL_TARGET" --package worker --package broccoli-compare

COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    if [ "$USE_CN_MIRRORS" = "true" ]; then \
      export RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup \
        RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup; \
    fi && \
    if [ -n "$CARGO_BUILD_RUSTFLAGS" ]; then \
      export RUSTFLAGS="$CARGO_BUILD_RUSTFLAGS"; \
    fi && \
    cargo build --profile "$CARGO_BUILD_PROFILE" --locked --target "$MUSL_TARGET" --package worker --package broccoli-compare && \
    mkdir -p /out && \
    cp "target/$MUSL_TARGET/$CARGO_BUILD_PROFILE/worker" /out/broccoli-worker && \
    cp "target/$MUSL_TARGET/$CARGO_BUILD_PROFILE/broccoli-compare" /out/broccoli-compare && \
    if [ "$CARGO_BUILD_PROFILE" != "profiling" ]; then \
      strip /out/broccoli-worker /out/broccoli-compare; \
    fi && \
    for b in /out/broccoli-worker /out/broccoli-compare; do \
      file "$b" | grep -Eq "statically linked|static-pie linked" || { echo "NOT STATIC: $b"; file "$b"; exit 1; }; \
    done

FROM ${RUNTIME_IMAGE} AS isolate-builder

ARG ISOLATE_VERSION=v2.0
ARG ISOLATE_REPO=https://github.com/ioi/isolate.git
ARG ISOLATE_REPO_CN_MIRROR=
ARG USE_CN_MIRRORS=false
WORKDIR /tmp/isolate

# hadolint ignore=DL3008
RUN if [ "$USE_CN_MIRRORS" = "true" ]; then \
      sed -i 's|archive.ubuntu.com|mirrors.tuna.tsinghua.edu.cn|g; s|security.ubuntu.com|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list; \
    fi && \
    ( apt-get update || ( \
      sed -i 's|archive.ubuntu.com|old-releases.ubuntu.com|g; s|security.ubuntu.com|old-releases.ubuntu.com|g' /etc/apt/sources.list && \
      apt-get update ) ) && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      gcc \
      libc6-dev \
      libcap-dev \
      libseccomp-dev \
      libsystemd-dev \
      make \
      pkg-config && \
    rm -rf /var/lib/apt/lists/*

RUN isolate_repo="$ISOLATE_REPO" && \
    if [ "$USE_CN_MIRRORS" = "true" ] && [ -n "$ISOLATE_REPO_CN_MIRROR" ]; then \
      isolate_repo="$ISOLATE_REPO_CN_MIRROR"; \
    fi && \
    git clone --branch "$ISOLATE_VERSION" --depth 1 "$isolate_repo" . && \
    make isolate isolate-cg-keeper && \
    mkdir -p /out/isolate/usr/local/bin /out/isolate/usr/local/sbin /out/isolate/usr/local/etc /out/isolate/usr/local/share/isolate && \
    install -m 4755 isolate /out/isolate/usr/local/bin/isolate && \
    install -m 0755 isolate-check-environment /out/isolate/usr/local/bin/isolate-check-environment && \
    install -m 0755 isolate-cg-keeper /out/isolate/usr/local/sbin/isolate-cg-keeper && \
    install -m 0644 default.cf /out/isolate/usr/local/etc/isolate && \
    install -m 0644 default.cf /out/isolate/usr/local/share/isolate/default.cf

FROM ${RUNTIME_IMAGE} AS runtime-base

ARG USE_CN_MIRRORS=false
ARG CREATED=unknown
ARG REVISION=unknown
ARG SOURCE=https://github.com/THUSAAC-PSD/broccoli
ARG VERSION=dev

LABEL org.opencontainers.image.title="Broccoli Worker" \
      org.opencontainers.image.description="Broccoli worker runtime with isolate sandbox" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="THUSAAC-PSD" \
      org.opencontainers.image.documentation="https://github.com/THUSAAC-PSD/broccoli/blob/main/docs/build.md" \
      org.opencontainers.image.created="${CREATED}"

# hadolint ignore=DL3008
RUN if [ "$USE_CN_MIRRORS" = "true" ]; then \
      sed -i 's|archive.ubuntu.com|mirrors.tuna.tsinghua.edu.cn|g; s|security.ubuntu.com|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list; \
    fi && \
    ( apt-get update || ( \
      sed -i 's|archive.ubuntu.com|old-releases.ubuntu.com|g; s|security.ubuntu.com|old-releases.ubuntu.com|g' /etc/apt/sources.list && \
      apt-get update ) ) && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      debianutils \
      gosu \
      libcap2 \
      libseccomp2 \
      libsystemd0 \
      tini && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 worker && \
    useradd --uid 10001 --gid 10001 --create-home --home-dir /home/worker --shell /usr/sbin/nologin worker && \
    mkdir -p /data /run/isolate /var/local/lib/isolate && \
    chown -R worker:worker /data /run/isolate /var/local/lib/isolate && \
    echo 'worker:1000000:65536' >> /etc/subuid && \
    echo 'worker:1000000:65536' >> /etc/subgid

COPY --from=rust-builder --chown=root:root /out/broccoli-worker /usr/local/bin/broccoli-worker
# broccoli-compare is the native output comparator the fused `check` step mounts
# into the isolate sandbox as a MountSource::PlatformTool. Ship it in a stable
# tools dir and point the worker at it so judging resolves the tool by name.
COPY --from=rust-builder --chown=root:root /out/broccoli-compare /opt/broccoli/tools/broccoli-compare
COPY --from=isolate-builder --chown=root:root /out/isolate/ /
COPY --chown=root:root docker-entrypoint-worker.sh /usr/local/bin/docker-entrypoint-worker.sh

RUN chmod 0755 /usr/local/bin/broccoli-worker /usr/local/bin/docker-entrypoint-worker.sh /opt/broccoli/tools/broccoli-compare

ENV BROCCOLI__WORKER__SANDBOX_BACKEND=isolate \
    BROCCOLI__WORKER__ISOLATE_BIN=/usr/local/bin/isolate \
    BROCCOLI__WORKER__ENABLE_CGROUPS=true \
    BROCCOLI__WORKER__TOOLS__DIR=/opt/broccoli/tools \
    BROCCOLI__STORAGE__DATA_DIR=/data \
    RUST_LOG=info

WORKDIR /data
EXPOSE 9091

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["gosu", "worker:worker", "/usr/local/bin/broccoli-worker", "--healthcheck"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint-worker.sh"]
CMD ["/usr/local/bin/broccoli-worker"]

FROM runtime-base AS runtime-icpc

ARG GCC_VERSION=9.3.0
ARG GCC_APT_VERSION=9.3.0-17ubuntu1~20.04

# sources.list mirror rewrite is inherited from runtime-base (persists down the
# layer chain), so no per-stage sed here.
# hadolint ignore=DL3008
RUN ( apt-get update || ( \
      sed -i 's|archive.ubuntu.com|old-releases.ubuntu.com|g; s|security.ubuntu.com|old-releases.ubuntu.com|g' /etc/apt/sources.list && \
      apt-get update ) ) && \
    apt-get install -y --no-install-recommends \
      default-jdk-headless \
      cpp-9=${GCC_APT_VERSION} \
      gcc-9=${GCC_APT_VERSION} \
      g++-9=${GCC_APT_VERSION} \
      libgcc-9-dev=${GCC_APT_VERSION} \
      libstdc++-9-dev=${GCC_APT_VERSION} \
      python3 && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-9 100 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-9 100 && \
    rm -rf /var/lib/apt/lists/* && \
    gcc --version | head -1 | grep -Fq "$GCC_VERSION" || { echo "gcc != $GCC_VERSION"; gcc --version; exit 1; } && \
    g++ --version | head -1 | grep -Fq "$GCC_VERSION" || { echo "g++ != $GCC_VERSION"; g++ --version; exit 1; } && \
    python3 --version | grep -Fq "Python 3.8" || { echo "python3 != 3.8"; python3 --version; exit 1; } && \
    ldd --version | head -1 | grep -Fq "2.31" || { echo "glibc != 2.31"; ldd --version; exit 1; }

FROM runtime-icpc AS runtime-full

ARG KOTLIN_VERSION=1.9.24

# hadolint ignore=DL3008
RUN ( apt-get update || ( \
      sed -i 's|archive.ubuntu.com|old-releases.ubuntu.com|g; s|security.ubuntu.com|old-releases.ubuntu.com|g' /etc/apt/sources.list && \
      apt-get update ) ) && \
    apt-get install -y --no-install-recommends \
      curl \
      fpc \
      golang-go \
      nodejs \
      rustc \
      unzip && \
    rm -rf /var/lib/apt/lists/* && \
    fpc -iV | grep -Fq "3.0.4" || { echo "fpc != 3.0.4"; fpc -iV; exit 1; }

# kotlin is not in focal apt -> install the pinned official compiler tarball
# (keeps the language; JDK for kotlinc is inherited from runtime-icpc).
RUN curl -fsSL -o /tmp/kotlin.zip \
      "https://github.com/JetBrains/kotlin/releases/download/v${KOTLIN_VERSION}/kotlin-compiler-${KOTLIN_VERSION}.zip" && \
    unzip -q /tmp/kotlin.zip -d /opt && \
    rm /tmp/kotlin.zip && \
    ln -s /opt/kotlinc/bin/kotlinc /usr/local/bin/kotlinc && \
    ln -s /opt/kotlinc/bin/kotlin  /usr/local/bin/kotlin && \
    kotlinc -version 2>&1 | grep -Fq "${KOTLIN_VERSION}" || { echo "kotlin != ${KOTLIN_VERSION}"; kotlinc -version; exit 1; }
