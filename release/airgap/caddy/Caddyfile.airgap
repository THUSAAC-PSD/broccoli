# Air-gapped LAN Caddyfile: explicit internal-CA leaf, no automatic online cert
# issuance. Mounted UN-rendered into the gateway container; Caddy expands
# {$LAN_HOST}/{$TLS_CERT}/{$TLS_KEY}/{$BROCCOLI_UPSTREAMS} from the container
# environment at load time. Never run envsubst over this file — that corrupts
# Caddy's {$VAR} placeholder syntax. There is no internet on-site, so cert
# automation cannot be reached; the server serves the leaf minted from the CA.
{
	admin off
	auto_https off
}
{$LAN_HOST} {
	encode zstd gzip
	tls {$TLS_CERT} {$TLS_KEY}
	reverse_proxy {$BROCCOLI_UPSTREAMS}
}
