BROCCOLI_ROLE=gateway
# Each role is its own Compose project, so roles on one host get separate
# networks. Keep this unchanged once the role is running: its volumes are
# named after it.
COMPOSE_PROJECT_NAME=broccoli-gateway
CADDY_IMAGE=caddy:2-alpine
BROCCOLI_GATEWAY_HTTP_BIND=0.0.0.0:80
BROCCOLI_UPSTREAMS='10.0.0.21:3000 10.0.0.22:3000 10.0.0.23:3000'
