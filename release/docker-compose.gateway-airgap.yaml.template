# Air-gap TLS gateway: terminates HTTPS on 443 with the internal-CA leaf and
# reverse-proxies to the broccoli server. The Caddyfile is mounted UN-rendered;
# Caddy expands {$LAN_HOST}/{$TLS_CERT}/{$TLS_KEY}/{$BROCCOLI_UPSTREAMS} from
# THIS container's environment at load time. Never envsubst it — that corrupts
# Caddy's {$VAR} syntax. Image comes from the bundle via `docker load`;
# `install.sh` composes this with `--pull never`.
services:
  gateway:
    image: ${CADDY_IMAGE:-caddy:2-alpine}
    restart: unless-stopped
    ports:
      - "${BROCCOLI_GATEWAY_HTTPS_BIND:-0.0.0.0:443}:443"
    environment:
      LAN_HOST: "${LAN_HOST}"
      TLS_CERT: /etc/broccoli-tls/server.crt
      TLS_KEY: /etc/broccoli-tls/server.key
      BROCCOLI_UPSTREAMS: "${BROCCOLI_UPSTREAMS:-server:3000}"
    command: ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
    volumes:
      - ../caddy/Caddyfile.airgap:/etc/caddy/Caddyfile:ro
      - "${BROCCOLI_TLS_DIR:?BROCCOLI_TLS_DIR must point at the server TLS cert dir}:/etc/broccoli-tls:ro"
      - caddy_data:/data
      - caddy_config:/config

volumes:
  caddy_data:
  caddy_config:
